# Copie para .env.local e ajuste.

# mock → dados de demonstração guardados no navegador (sem servidor)
# http → usa o backend PHP em <VITE_API_BASE>/api
# (vazio) → em desenvolvimento, mock; no site publicado, usa o PHP se /api/saude disser que está instalado
VITE_API_MODE=mock

# Deixe vazio quando o frontend e a API estão no mesmo domínio (caso da Hostinger).
VITE_API_BASE=
